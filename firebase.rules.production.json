{
  "rules": {
    ".read": "auth != null && root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true",
    ".write": false,
    "adminProfiles": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true)",
        ".write": "auth != null && root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true"
      }
    },
    "studentProfilesV3": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true)"
      }
    },
    "teacherProfiles": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true)",
        ".write": "auth != null && root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true"
      }
    },
    "teacherSubmissions": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true)",
        "$submissionId": {
          ".write": "auth != null && (root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true || (auth.uid === $uid && root.child('teacherProfiles').child(auth.uid).child('isActive').val() === true && ((!data.exists() && newData.child('status').val() === 'pending') || (data.child('status').val() === 'pending' && newData.child('status').val() === 'pending'))))"
        }
      }
    },
    "customSubjects": {
      ".read": true,
      ".write": "auth != null && root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true"
    },
    "lessons": {
      ".read": true,
      ".write": "auth != null && root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true",
      ".indexOn": [
        "subject",
        "stage",
        "teacherId"
      ]
    },
    "quizzes": {
      ".read": true,
      ".write": "auth != null && root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true",
      ".indexOn": [
        "subject",
        "stage"
      ]
    },
    "files": {
      ".read": true,
      ".write": "auth != null && root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true",
      ".indexOn": [
        "stage",
        "subject"
      ]
    },
    "simulations": {
      ".read": true,
      ".write": "auth != null && root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true",
      ".indexOn": [
        "stage"
      ]
    },
    "liveSessions": {
      ".read": true,
      ".write": "auth != null && root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true"
    },
    "leaderboardV3": {
      ".read": "auth != null",
      "$period": {
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true)",
          "name": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 80)"
          },
          "xp": {
            ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)"
          },
          "quizzes": {
            ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)"
          },
          "level": {
            ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 1)"
          },
          "updatedAt": {
            ".validate": "!newData.exists() || newData.isNumber()"
          }
        },
        ".indexOn": [
          "xp"
        ]
      }
    },
    "contentAnalytics": {
      ".read": "auth != null",
      "$contentId": {
        ".write": "auth != null",
        "views": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)"
        },
        "completions": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)"
        },
        "quizAttempts": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)"
        },
        "quizScoreTotal": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)"
        },
        "quizAverage": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100)"
        },
        "updatedAt": {
          ".validate": "!newData.exists() || newData.isNumber()"
        }
      }
    },
    "community": {
      ".read": "auth != null",
      "forums": {
        "$postId": {
          ".write": "auth != null && (root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true || (!data.exists() && newData.child('authorId').val() === auth.uid))",
          "likesBy": {
            "$uid": {
              ".write": "auth != null && (auth.uid === $uid || root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true)",
              ".validate": "!newData.exists() || newData.val() === true"
            }
          },
          "reports": {
            "$uid": {
              ".write": "auth != null && (auth.uid === $uid || root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true)"
            }
          }
        }
      },
      "studyGroups": {
        "$groupId": {
          ".write": "auth != null && root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true",
          "members": {
            "$uid": {
              ".write": "auth != null && (auth.uid === $uid || root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true)"
            }
          }
        }
      }
    },
    "announcements": {
      ".read": true,
      ".write": "auth != null && root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true"
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true"
    },
    "posts": {
      ".read": true,
      ".write": "auth != null && root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true"
    },
    "leaderboard": {
      ".read": false,
      ".write": "auth != null && root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true"
    },
    "users": {
      ".read": false,
      ".write": false
    },
    "access_codes": {
      ".read": false,
      ".write": false
    },
    "assignments": {
      ".read": "auth != null",
      "$assignmentId": {
        ".write": "auth != null && (root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true || (data.child('teacherId').val() === auth.uid && root.child('teacherProfiles').child(auth.uid).child('isActive').val() === true && !newData.exists()))",
        "title": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length > 0 && newData.val().length <= 120)"
        },
        "teacherId": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "dueAt": {
          ".validate": "!newData.exists() || newData.isNumber()"
        },
        "maxScore": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() > 0 && newData.val() <= 1000)"
        }
      },
      ".indexOn": [
        "stage",
        "subject",
        "dueAt",
        "teacherId"
      ]
    },
    "assignmentSubmissions": {
      "$assignmentId": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('assignments').child($assignmentId).child('teacherId').val() === auth.uid || root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true)",
          ".write": "auth != null && (root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true || (root.child('assignments').child($assignmentId).child('teacherId').val() === auth.uid && root.child('teacherProfiles').child(auth.uid).exists() && root.child('teacherProfiles').child(auth.uid).child('isActive').val() === true) || (auth.uid === $uid && root.child('assignments').child($assignmentId).exists() && (!data.exists() || data.child('status').val() !== 'graded') && newData.child('status').val() === 'submitted' && !newData.child('score').exists() && !newData.child('maxScore').exists() && !newData.child('percent').exists() && !newData.child('feedback').exists() && !newData.child('gradedAt').exists() && !newData.child('gradedBy').exists()))",
          "status": {
            ".validate": "!newData.exists() || newData.val() === 'submitted' || newData.val() === 'graded'"
          },
          "score": {
            ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000)"
          },
          "feedback": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 2000)"
          },
          "maxScore": {
            ".validate": "!newData.exists() || (newData.isNumber() && newData.val() > 0 && newData.val() <= 1000)"
          },
          "percent": {
            ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100)"
          },
          "gradedAt": {
            ".validate": "!newData.exists() || newData.isNumber()"
          },
          "gradedBy": {
            ".validate": "!newData.exists() || newData.isString()"
          }
        },
        ".read": "auth != null && (root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true || (root.child('assignments').child($assignmentId).child('teacherId').val() === auth.uid && root.child('teacherProfiles').child(auth.uid).child('isActive').val() === true))",
        ".write": "auth != null && (root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true || (root.child('assignments').child($assignmentId).child('teacherId').val() === auth.uid && root.child('teacherProfiles').child(auth.uid).child('isActive').val() === true && !newData.exists()))"
      }
    },
    "scheduleEvents": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true",
      ".indexOn": [
        "stage"
      ]
    },
    "notificationBroadcasts": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('adminProfiles').child(auth.uid).child('isAdmin').val() === true"
    }
  }
}
